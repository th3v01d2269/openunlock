<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.openunlock">

    <!-- Shizuku API permission (Shizuku app + wireless debugging on the
         phone). Without Shizuku the app still runs its offline features. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- NFC tap-to-run. The phone running OpenUnlock is the READER: a
         client phone tapped against it presents itself as an NFC tag and
         that detection triggers the default action (FRP status). NFC is
         optional — the app works fully without it. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenUnlock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: openunlock://frp | imei | firmware | profiles | info
                 Used by Tasker (Browse URL / am start) and Termux triggers.
                 singleTop + onNewIntent delivers them to the running activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openunlock" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="openunlock" />
            </intent-filter>
        </activity>
        <!-- Crash screen (v0.2.4): launched by the global uncaught-
             exception handler to show the crash instead of the app
             silently vanishing. Never launched by the user. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="OpenUnlock crashed" />
    </application>
</manifest>
